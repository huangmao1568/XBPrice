<Page
    x:Class="XBPrice.DatabasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XBPrice"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  自定义标题栏（与主页保持一致，替代系统标题栏并让开右上角窗口按钮）  -->
        <TitleBar
            x:Name="appTitleBar"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            Subtitle="价格数据库" />

        <Grid
            Grid.Row="1"
            Padding="{StaticResource AppPagePadding}"
            RowSpacing="{StaticResource AppSpacingS}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ================= 顶部：返回 + 标题 + 筛选 =================  -->
        <Border
            Grid.Row="0"
            Padding="{StaticResource AppToolbarPadding}"
            Style="{StaticResource AppCardStyle}">
            <Grid ColumnSpacing="{StaticResource AppSpacingL}" RowSpacing="{StaticResource AppSpacingM}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="backButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Height="32"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回报价查询">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                        <TextBlock Text="返回" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock Text="数据库 · 月均价格" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource AppSecondaryTextStyle}" Text="按城市、月份、规格与牌号统计已入库报价的月均价与价格区间" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{StaticResource AppSpacingS}">
                    <ProgressRing
                        x:Name="ring"
                        Width="22"
                        Height="22"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="refreshButton"
                        Click="RefreshButton_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="按当前筛选重新读取数据库">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  筛选条件  -->
                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Spacing="{StaticResource AppSpacingL}">
                    <StackPanel
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="0">
                        <ToggleButton
                            x:Name="summaryViewButton"
                            MinWidth="90"
                            Click="ViewModeButton_Click"
                            IsChecked="True"
                            Tag="summary">
                            <TextBlock Text="月均汇总" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="rawViewButton"
                            MinWidth="90"
                            Click="ViewModeButton_Click"
                            Tag="raw">
                            <TextBlock Text="原始数据" />
                        </ToggleButton>
                    </StackPanel>
                    <ComboBox
                        x:Name="cityFilter"
                        MinWidth="130"
                        VerticalAlignment="Bottom"
                        Header="城市"
                        SelectionChanged="Filter_SelectionChanged" />
                    <ComboBox
                        x:Name="monthFilter"
                        MinWidth="120"
                        VerticalAlignment="Bottom"
                        Header="月份"
                        SelectionChanged="Filter_SelectionChanged" />
                    <ComboBox
                        x:Name="productFilter"
                        MinWidth="130"
                        VerticalAlignment="Bottom"
                        Header="品名"
                        SelectionChanged="Filter_SelectionChanged" />
                    <!--  牌号 / 规格：与城市 / 月份 / 品名保持一致的普通单选下拉  -->
                    <ComboBox
                        x:Name="gradeFilter"
                        MinWidth="150"
                        VerticalAlignment="Bottom"
                        Header="牌号"
                        SelectionChanged="Filter_SelectionChanged" />
                    <ComboBox
                        x:Name="specFilter"
                        MinWidth="170"
                        VerticalAlignment="Bottom"
                        Header="规格"
                        SelectionChanged="Filter_SelectionChanged" />
                    <TextBlock
                        x:Name="dbPathText"
                        MaxWidth="300"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AppTertiaryTextStyle}"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ================= 概览卡片 =================  -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="{StaticResource AppSpacingM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  整体月均价  -->
            <Border
                Grid.Column="0"
                Padding="{StaticResource AppCardPadding}"
                Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingXS}">
                    <TextBlock Style="{StaticResource AppSecondaryTextStyle}" Text="整体月均价" />
                    <TextBlock
                        x:Name="kpiAvg"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="—" />
                </StackPanel>
            </Border>

            <!--  单价区间  -->
            <Border
                Grid.Column="1"
                Padding="{StaticResource AppCardPadding}"
                Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingXS}">
                    <TextBlock Style="{StaticResource AppSecondaryTextStyle}" Text="价格区间" />
                    <TextBlock
                        x:Name="kpiRange"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="—"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  覆盖月份  -->
            <Border
                Grid.Column="2"
                Padding="{StaticResource AppCardPadding}"
                Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingXS}">
                    <TextBlock Style="{StaticResource AppSecondaryTextStyle}" Text="覆盖月份" />
                    <TextBlock
                        x:Name="kpiMonths"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="—" />
                </StackPanel>
            </Border>

            <!--  涉及城市  -->
            <Border
                Grid.Column="3"
                Padding="{StaticResource AppCardPadding}"
                Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingXS}">
                    <TextBlock Style="{StaticResource AppSecondaryTextStyle}" Text="涉及城市" />
                    <TextBlock
                        x:Name="kpiCities"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="—" />
                </StackPanel>
            </Border>

            <!--  涉及品名  -->
            <Border
                Grid.Column="4"
                Padding="{StaticResource AppCardPadding}"
                Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="{StaticResource AppSpacingXS}">
                    <TextBlock Style="{StaticResource AppSecondaryTextStyle}" Text="涉及品名" />
                    <TextBlock
                        x:Name="kpiProducts"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="—" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  ================= 月均价格明细表 =================  -->
        <Border
            Grid.Row="2"
            Style="{StaticResource AppCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="{StaticResource AppPanelHeaderPadding}"
                    x:Name="listHeaderPanel">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}">
                        <FontIcon Style="{StaticResource AppPanelHeaderIconStyle}" Glyph="&#xE9D2;" />
                        <TextBlock
                            x:Name="listTitleText"
                            Style="{StaticResource AppPanelHeaderTextStyle}"
                            Text="月均价明细" />
                        <TextBlock
                            x:Name="rowCountText"
                            Style="{StaticResource AppRowCountTextStyle}"
                            Text="" />
                    </StackPanel>
                </Grid>

                <!--  ========== 视图一：月均汇总 ==========  -->
                <Grid x:Name="summaryPanel" Grid.Row="1" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  表头  -->
                    <!--
                      右侧留白说明（避免表头与数据行错位的核心）：
                      ListView 的竖向滚动条会占掉 16px 宽度，而表头是独立 Border 不占。
                      因此这里在表头内层 Grid 右侧补 16+14=30，
                      数据行则在 ListView 侧通过 Padding 补 16（见下方 ListView 的 Padding）。
                      两边右侧基准一致，列才会逐列对齐。
                    -->
                    <Border
                        Grid.Row="0"
                        Margin="8,0,8,0"
                        Style="{StaticResource AppTableHeaderStyle}">
                        <Grid Padding="14,6,30,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" MinWidth="80" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="184" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="序号" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="年月" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="城市" />
                            <TextBlock
                                Grid.Column="3"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="品名" />
                            <TextBlock
                                Grid.Column="4"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="牌号" />
                            <TextBlock
                                Grid.Column="5"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="规格" />
                            <TextBlock
                                Grid.Column="6"
                                HorizontalAlignment="Right"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="天数" />
                            <TextBlock
                                Grid.Column="7"
                                HorizontalAlignment="Right"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="条数" />
                            <TextBlock
                                Grid.Column="8"
                                HorizontalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="月均价" />
                            <TextBlock
                                Grid.Column="9"
                                HorizontalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="最低 ~ 最高" />
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="monthlyList"
                        Grid.Row="1"
                        Margin="8,0,8,8"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource AppTableRowContainerStyle}"
                        ItemsSource="{x:Bind Rows}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:MonthlyRow">
                                <Grid
                                    Height="32"
                                    Padding="14,0,30,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" MinWidth="80" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="184" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppTertiaryTextStyle}"
                                        Text="{x:Bind Index}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind YearMonth}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSecondaryTextStyle}"
                                        Text="{x:Bind City}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ProductName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSecondaryTextStyle}"
                                        Text="{x:Bind Grade}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="5"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSecondaryTextStyle}"
                                        Text="{x:Bind Spec}" />
                                    <TextBlock
                                        Grid.Column="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSecondaryTextStyle}"
                                        Text="{x:Bind DayCount}" />
                                    <TextBlock
                                        Grid.Column="7"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSecondaryTextStyle}"
                                        Text="{x:Bind ItemCount}" />
                                    <TextBlock
                                        Grid.Column="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind AvgPriceText}"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Grid.Column="9"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSecondaryTextStyle}"
                                        Text="{x:Bind RangeText}"
                                        TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!--  ========== 视图二：原始数据明细 ==========  -->
                <Grid
                    x:Name="rawPanel"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  表头  -->
                    <Border
                        Grid.Row="0"
                        Margin="8,0,8,0"
                        Style="{StaticResource AppTableHeaderStyle}">
                        <Grid Padding="14,6,30,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="序号" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="报价日期" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="城市" />
                            <TextBlock
                                Grid.Column="3"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="品名" />
                            <TextBlock
                                Grid.Column="4"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="牌号" />
                            <TextBlock
                                Grid.Column="5"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="规格" />
                            <TextBlock
                                Grid.Column="6"
                                HorizontalAlignment="Right"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="价格（元/吨）" />
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="rawList"
                        Grid.Row="1"
                        Margin="8,0,8,8"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource AppTableRowContainerStyle}"
                        ItemsSource="{x:Bind RawRows}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RawRow">
                                <Grid
                                    Height="32"
                                    Padding="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppTertiaryTextStyle}"
                                        Text="{x:Bind Index}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind QuoteDate}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSecondaryTextStyle}"
                                        Text="{x:Bind City}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ProductName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSecondaryTextStyle}"
                                        Text="{x:Bind Grade}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="5"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AppSecondaryTextStyle}"
                                        Text="{x:Bind Spec}" />
                                    <TextBlock
                                        Grid.Column="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind PriceText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  空状态  -->
                    <StackPanel
                        x:Name="rawEmptyPanel"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource AppSpacingS}"
                        Visibility="Collapsed">
                        <FontIcon Style="{StaticResource AppEmptyStateIconStyle}" Glyph="&#xE9D9;" />
                        <TextBlock Style="{StaticResource AppEmptyStateTextStyle}" Text="当前筛选条件下没有原始报价记录" />
                        <TextBlock Style="{StaticResource AppEmptyStateHintStyle}" Text="试着放宽城市、月份或规格筛选条件" />
                    </StackPanel>
                </Grid>

                <!--  空状态  -->
                <StackPanel
                    x:Name="emptyPanel"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource AppSpacingS}">
                    <FontIcon Style="{StaticResource AppEmptyStateIconStyle}" Glyph="&#xE9D9;" />
                    <TextBlock Style="{StaticResource AppEmptyStateTextStyle}" Text="当前筛选条件下没有月均数据" />
                    <TextBlock Style="{StaticResource AppEmptyStateHintStyle}" Text="先回主页面抓取报价，或放宽上面的筛选条件" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid
            Grid.Row="3"
            ColumnSpacing="{StaticResource AppSpacingM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  左下角：数据总条数标签  -->
            <Border
                Grid.Column="0"
                Padding="12,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Style="{StaticResource AppInnerPanelStyle}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        x:Name="totalCountText"
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="数据总条数：—" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="statusBar"
                Grid.Column="1"
                MaxWidth="720"
                IsOpen="False" />
        </Grid>
        </Grid>
    </Grid>
</Page>
