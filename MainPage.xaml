<Page
    x:Class="XBPrice.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XBPrice"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  页面本身不设背景，让窗口的亚克力/云母背景透出来  -->
    <Grid Padding="16,4,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ================= 顶部工具栏 =================  -->
        <Border
            Grid.Row="0"
            Padding="20,14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="16" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  标题  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock Text="工作日价格查询" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="选择城市与日期范围，抓取报价数据并导出为 CSV" />
                </StackPanel>

                <!--  操作按钮  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        x:Name="ring"
                        Width="22"
                        Height="22"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="fetchButton"
                        Click="FetchButton_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="抓取所选日期范围内的报价">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock Text="获取数据" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="exportButton"
                        Click="ExportButton_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="把当前结果导出为 CSV 文件">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74E;" />
                            <TextBlock Text="导出 CSV" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  筛选条件  -->
                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="16">
                    <ToggleSwitch
                        x:Name="inputModeToggle"
                        MinWidth="140"
                        VerticalAlignment="Bottom"
                        OffContent="选择城市"
                        OnContent="手动输入"
                        Toggled="InputModeToggle_Toggled" />
                    <ComboBox
                        x:Name="cityPicker"
                        MinWidth="150"
                        VerticalAlignment="Bottom"
                        Header="城市"
                        ItemsSource="{x:Bind Cities}" />
                    <TextBox
                        x:Name="cityInput"
                        MinWidth="150"
                        VerticalAlignment="Bottom"
                        Header="城市拼音"
                        IsEnabled="False"
                        PlaceholderText="例如 shanghai" />
                    <DatePicker
                        x:Name="startDatePicker"
                        VerticalAlignment="Bottom"
                        Header="开始日期" />
                    <DatePicker
                        x:Name="endDatePicker"
                        VerticalAlignment="Bottom"
                        Header="结束日期" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ================= 主体内容 =================  -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!--  网页预览  -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Padding="14,12"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE774;" />
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="网页预览" />
                    </StackPanel>

                    <!--  WinUI 3 中旧版 WebView(EdgeHTML) 已移除，改用基于 Chromium 的 WebView2  -->
                    <WebView2
                        x:Name="webview"
                        Grid.Row="1"
                        Margin="1,0,1,1" />
                </Grid>
            </Border>

            <!--  可拖拽的列分隔条  -->
            <controls:GridSplitter
                Grid.Column="1"
                Width="12"
                Margin="4,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                CornerRadius="3"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                ToolTipService.ToolTip="拖动以调整左右宽度" />

            <!--  数据列表  -->
            <Border
                Grid.Column="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8A9;" />
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="报价数据" />
                        </StackPanel>
                        <TextBlock
                            x:Name="emptyHint"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="暂无数据" />
                    </Grid>

                    <GridView
                        x:Name="dataGrid"
                        Grid.Row="1"
                        Margin="8,0,8,8"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind Model}"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ColumnData">
                                <Border
                                    Width="228"
                                    Margin="4"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                FontSize="13"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE787;" />
                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind DateText}" />
                                        </StackPanel>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Values}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Border>
        </Grid>

        <!--  ================= 状态提示 =================  -->
        <InfoBar
            x:Name="statusBar"
            Grid.Row="2"
            Margin="0,12,0,0"
            IsOpen="False" />
    </Grid>
</Page>
